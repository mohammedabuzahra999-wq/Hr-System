  "evaluation": {
    "mode": "MOCK",
    "implementation": "MockReportEvaluator extends the unchanged Phase 1 MockEvaluator; every output uses the same independent verifier and persistence path.",
    "input": "Ready-time frozen rubric/criteria/weights, served question mappings, final-answer source event sequence/turn/question and explicit evaluator version. Excludes candidate PII, HR notes, sessions, invitation secrets, raw audio, partial-only text and answer finalization/job/review timestamps.",
    "inputHash": "SHA256 over the existing canonicalJson ordering and versioned shared evaluation input schema. Later JD/scorecard changes cannot mutate stored input.",
    "criterionStatuses": [
      "ASSESSED",
      "PARTIALLY_ASSESSED",
      "NOT_ASSESSED"
    ],
    "scoreRule": "Existing frozen 0–4 anchors; synthetic question-type dimension mapping is explicit. Lowest supported fixture anchor across eligible answers; rationale names each frozen dimension/anchor. No score penalty for time/connection/clarification/language.",
    "notAssessed": "score=null with no trusted evidence; absent criterion coverage cannot disappear or become zero.",
    "evidence": "Persisted CANDIDATE_FINAL_ANSWER only; exact question, turn, criterion and event sequence checked independently. Bounds and exact slice validated; no normalization.",
    "offsets": "UTF16_CODE_UNIT; reject spans splitting surrogate pairs.",
    "invalidEvidencePolicy": "Reject entire report; FAILED/EVIDENCE_VALIDATION_FAILED, report=null, no invented output persisted/displayed. Interview remains COMPLETED with answers preserved.",
    "findings": "Strengths/concerns must reference validated evidence in the same criterion. Missing coverage is a limitation, not a candidate weakness.",
    "coverage": "Count assessed/partial/not assessed separately; percent=(assessed+partial)/total*100 rounded to 2 decimals; coverage is not performance.",
    "aggregation": "NONE_APPROVED_FOR_0_4; overallScore=null. Frozen weights retained; no invented overall/equal weighting.",
    "noProtectedTraitOrVoiceInference": true,
    "noAutomaticHiringDecision": true,
    "audit": "Existing AUDIT events for requested/running/completed/failed/retried/reviewed; IDs, reportVersion and safe codes/status only. COMMAND fingerprints hash exact requests, including notes, rather than storing plaintext."
  },
