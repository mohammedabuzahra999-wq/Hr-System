    "check:ai-interviewer:tts:ui": "node --conditions=development --import tsx scripts/checkTtsPlaybackUi.mjs",
    "check:ai-interviewer:tts:browser": "node scripts/checkTtsPlaybackBrowser.mjs",
    "check:ai-interviewer:llm": "node --conditions=development --import tsx src/aiInterviewer/llmOrchestration.check.ts",
    "check:ai-interviewer:llm:contract": "node --conditions=development --import tsx src/aiInterviewer/llmProviders.check.ts",
    "check:ai-interviewer:llm:browser": "node scripts/checkLlmOrchestrationBrowser.mjs",
    "check:ai-interviewer:evaluation": "node --conditions=development --import tsx src/aiInterviewer/evaluationIntegration.check.ts",
