    "benchmark:local": "node --import ./scripts/runtimePreload.mjs --conditions=development --import tsx src/copilot/benchmark/run.ts",
    "benchmark:openrouter": "node --import ./scripts/runtimePreload.mjs --conditions=development --import tsx src/copilot/benchmark/openrouter.run.ts",
    "check:benchmark:openrouter": "node --conditions=development --import tsx src/copilot/benchmark/openrouter.check.ts",
    "db:generate": "node --import ./scripts/runtimePreload.mjs ../../node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "tsx --import ./scripts/runtimePreload.mjs src/db/migrate.ts",
    "db:migrate:payroll-auditor": "node --import ./scripts/runtimePreload.mjs scripts/applyPayrollAuditorMigration.mjs",
    "db:seed": "tsx --import ./scripts/runtimePreload.mjs src/db/seed.ts",
    "db:seed:jd": "tsx --import ./scripts/runtimePreload.mjs src/db/seedJobDescriptions.ts",
    "db:embed": "tsx --import ./scripts/runtimePreload.mjs src/db/backfillEmbeddings.ts",
    "db:cv:import": "tsx --import ./scripts/runtimePreload.mjs src/db/migrateCvsIntoDb.ts",
    "check:gate": "tsx --conditions=development src/copilot/gate.check.ts",
    "check:payroll": "tsx --conditions=development src/payroll/calculate.check.ts",
    "check:payroll-audit": "tsx --conditions=development src/payroll/auditRules.check.ts",
    "db:seed:payroll": "tsx --import ./scripts/runtimePreload.mjs src/payroll/seedPayroll.ts",
    "check:permissions": "tsx --conditions=development src/permissions.check.ts",
    "mcp": "tsx --import ./scripts/runtimePreload.mjs --conditions=development src/mcp/index.ts",
    "check:tour": "tsx --conditions=development src/guide/tour.check.ts",
    "check:scorecard": "tsx --conditions=development src/ai/scorecard.check.ts",
    "check:corpus": "tsx --conditions=development src/copilot/corpus.check.ts",
    "check:training": "tsx --conditions=development src/copilot/training.check.ts",
    "check:conversation": "tsx --conditions=development src/copilot/conversationTraining.check.ts",
    "check:voice": "tsx --conditions=development src/voice/session.check.ts"
