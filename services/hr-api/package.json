    "build": "tsc -p tsconfig.json && node scripts/copyCopilotTrainingData.mjs",
    "start": "node --import ./scripts/runtimePreload.mjs dist/services/hr-api/src/index.js",
    "check": "tsc --noEmit -p tsconfig.json",
    "check:ollama": "node --import ./scripts/runtimePreload.mjs --conditions=development --import tsx src/ai/ollama.check.ts",
    "check:resolve-question:ollama": "node --import ./scripts/runtimePreload.mjs --conditions=development --import tsx src/copilot/resolveQuestion.ollama.check.ts",
    "check:local-reads": "node --conditions=development --import tsx src/copilot/localReads.check.ts",
    "check:greetings": "node --conditions=development --import tsx src/copilot/greetings.check.ts",
