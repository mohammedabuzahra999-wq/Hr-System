  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@hono/node-server": "^2.1.1",
    "@hr/shared": "*",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "dotenv": "^17.2.4",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.8",
    "mammoth": "^1.12.3",
    "openai": "^7.20.0",
    "pg": "^8.23.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2"
  }
}
