    "check:ai-interviewer:persistence": "node --conditions=development --import tsx src/aiInterviewer/persistence.check.ts",
    "demo:ai-interviewer:ui": "node --conditions=development --import tsx src/aiInterviewer/ui.fixture.ts",
    "check:ai-interviewer:ui": "node --conditions=development --import tsx scripts/checkAiInterviewUi.mjs",
    "check:ai-interviewer:browser": "node scripts/checkAiInterviewBrowser.mjs",
    "demo:ai-interviewer": "node --conditions=development --import tsx src/aiInterviewer/scenario.ts",
    "voice:setup": "node scripts/setupLocalVoice.mjs",
    "voice:local": "node scripts/startLocalVoice.mjs",
