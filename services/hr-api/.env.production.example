# Production environment. Set these in the hosting dashboard, not in a file.
#
# Nothing here is a VITE_ variable on purpose: anything prefixed VITE_ is
# compiled into the JavaScript the browser downloads, where it is readable by
# everyone. Secrets are server-side only.

NODE_ENV=production

# Neon, from the dashboard. Keep `sslmode=require`.
DATABASE_URL=

# Signs the session cookie. Generate a fresh one, never reuse the dev value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# The service's own public URL, exactly, with no trailing slash.
# e.g. https://menaitech-hr.onrender.com
WEB_ORIGIN=

# From the OpenAI dashboard. Without it the job-description generator falls back
# to arranging what HR typed instead of writing — the app still runs.
OPENAI_API_KEY=

# The host sets PORT itself. Do not set it here.

# Whether employee data may be sent to the AI provider.
#
# The server always produces the figures itself; this decides whether the model
# is then shown them so it can write the sentence around them — names on a
# presence list, pay on an employee file, the text of a CV being screened.
#
# `false` stops all of that. Reports, tables and every figure still work; the
# written summary is absent and the screen says why. Set it if the company's
# policy is that employee data does not leave its own systems.
#
# Defaults to true.
AI_SHARE_DATA=true

# Enable only after the organisation approves sending microphone audio to the
# Realtime provider. OPENAI_API_KEY remains server-side; it is never bundled.
VOICE_ENABLED=false
VOICE_PROVIDER=openai
LOCAL_VOICE_URL=http://127.0.0.1:8766
VOICE_SHARE_AUDIO=false
# Must remain false. The server also refuses this adapter in production.
VOICE_DEV_MOCK=false
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_VOICE_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_REALTIME_VOICE=marin
# `ephemeral` gives the browser only a short-lived, scoped Realtime token.
VOICE_REALTIME_TRANSPORT=unified
