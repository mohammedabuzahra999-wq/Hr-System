# Copy to server/.env and fill in. server/.env is gitignored — never commit it.

# Neon connection string. Use the POOLED host for the app.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Signs session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Where the web app is served from, for CORS and cookie settings.
WEB_ORIGIN=http://localhost:5173

PORT=8787
NODE_ENV=development

# AI Interview observations: development only; always refused in production.
AI_INTERVIEW_DEV_MOCK=false

# Explicit provider selection for the upcoming provider adapters: openai or ollama.
# Currently selects resolveQuestion only; other AI services retain their providers.
# Provider selection must not be inferred from API keys or fall back to OpenAI.
AI_PROVIDER=openai
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# Voice is independent of AI_PROVIDER and AI_SHARE_DATA. Local audio stays on
# this machine. OpenAI Realtime requires explicit provider selection, the API
# key, VOICE_ENABLED=true and VOICE_SHARE_AUDIO=true.
VOICE_ENABLED=false
VOICE_PROVIDER=local
LOCAL_VOICE_URL=http://127.0.0.1:8766
VOICE_SHARE_AUDIO=false
# Local development only. It creates an app voice session with no microphone,
# no OpenAI connection, and sends typed final transcripts through /voice/turn.
# The server refuses it when NODE_ENV=production.
VOICE_DEV_MOCK=false
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_VOICE_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_REALTIME_VOICE=marin
# Use `ephemeral` only when the server's unified WebRTC path is unavailable.
# The browser receives a short-lived Realtime token, never OPENAI_API_KEY.
VOICE_REALTIME_TRANSPORT=unified
